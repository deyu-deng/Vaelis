# EditorConfig — unified baseline for the whole monorepo.
# Applies recursively to every file below this directory.
# See https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
# Python: keep the newline, let ruff format (100 cols) own line length.
max_line_length = 100

[*.{yml,yaml,json,md,toml}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_size = 4

[Makefile]
indent_style = tab
